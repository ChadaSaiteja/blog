---
layout: null
---
[
  {% assign posts = site.posts | where: "draft", false %}
  {% for post in posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "description": {{ post.description | default: post.excerpt | strip_html | strip_newlines | jsonify }},
      "categories": {{ post.categories | join: ', ' | downcase | jsonify }},
      "tags": {{ post.tags | join: ', ' | downcase | jsonify }},
      "date": "{{ post.date | date: '%B %d, %Y' }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
