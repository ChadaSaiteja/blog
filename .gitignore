# Local environment variables
.env

# Jekyll build and cache
_site/
.jekyll-cache/
.jekyll-metadata

# Python cache
__pycache__/
*.pyc

# IDEs and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local draft ideas (kept on disk, never committed)
ideas/

# Generated audit reports. Binary deliverables that are reproducible from the
# scripts and only useful locally, so they stay out of the history.
admin/seo-audit-*.docx
admin/seo-audit-*.pdf

# Sass compile cache, generated by any local Jekyll build
.sass-cache/
