# AI Provider Configuration
# Set to 'openai' or 'anthropic'
AI_PROVIDER=openai

# Model choice (e.g., gpt-4o-mini, gpt-4o, claude-3-5-sonnet-20241022)
AI_MODEL=gpt-4o-mini

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Configuration for Pull Request Publishing
# Personal Access Token with repository push access
GITHUB_TOKEN=
GITHUB_OWNER=chadasaiteja
GITHUB_REPOSITORY=chadasaiteja.github.io
